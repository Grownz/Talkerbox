{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Talkerbox",
  "version": "0.4.0",
  "identifier": "com.talkerbox.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Talkerbox",
        "width": 1000,
        "height": 760,
        "minWidth": 720,
        "minHeight": 520
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; connect-src ipc: http://ipc.localhost; media-src 'self' blob:; object-src 'none'; base-uri 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "windows": {
      "nsis": { "compression": "lzma", "installMode": "currentUser" }
    },
    "externalBin": ["binaries/tts-sidecar"],
    "resources": {
      "vosk/libvosk.dll": "libvosk.dll",
      "vosk/libgcc_s_seh-1.dll": "libgcc_s_seh-1.dll",
      "vosk/libstdc++-6.dll": "libstdc++-6.dll",
      "vosk/libwinpthread-1.dll": "libwinpthread-1.dll"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}
